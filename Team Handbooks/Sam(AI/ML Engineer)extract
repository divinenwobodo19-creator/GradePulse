17:     """
18:     File-based lock using fcntl for safe concurrent access.
19:     
20:     This ensures only one worker can write to the brain state file at a time,
21:     preventing corruption from concurrent writes.
22:     """
23:     def __init__(self, filepath: str):
24:         self.filepath = filepath
25:         self.lock_path = f"{filepath}.lock"
26:         self._lock_fd: Optional[int] = None
27:     
28:     def acquire(self, timeout: float = 30.0) -> bool:
29:         """
30:         Acquire the file lock.
31:         
32:         Args:
33:             timeout: Maximum seconds to wait for the lock.
34:             
35:         Returns:
36:             True if lock acquired, False if timeout.
37:         """
38:         start_time = time.time()
39:         while True:
40:             try:
41:                 self._lock_fd = os.open(self.lock_path, os.O_CREAT | os.O_RDWR)
42:                 fcntl.flock(self._lock_fd, fcntl.LOCK_EX | fcntl.LOCK_NB)
43:                 # Write PID for debugging
44:                 os.write(self._lock_fd, str(os.getpid()).encode())
45:                 return True
46:             except (IOError, OSError):
47:                 if self._lock_fd is not None:
48:                     os.close(self._lock_fd)
49:                     self._lock_fd = None
50:                 if time.time() - start_time >= timeout:
51:                     return False
52:                 time.sleep(0.01)
53:     
54:     def release(self):
55:         """Release the file lock."""
56:         if self._lock_fd is not None:
57:             try:
58:                 fcntl.flock(self._lock_fd, fcntl.LOCK_UN)
59:                 os.close(self._lock_fd)
60:             except (IOError, OSError):
61:                 pass
62:             finally:
63:                 self._lock_fd = None
64:     
65:     def __enter__(self):
66:         self.acquire()
67:         return self
68:     
69:     def __exit__(self, exc_type, exc_val, exc_tb):
70:         self.release()
71:         return False
