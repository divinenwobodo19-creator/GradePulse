160: def validate_student_id(raw: str, report: ValidationReport, row_num: int) -> Optional[str]:
161:     """Validate and clean student ID."""
162:     if not raw or not raw.strip():
163:         report.error(f"Row {row_num}: Empty student_id")
164:         return None
165:     sid = raw.strip()
166:     if len(sid) > 50:
167:         report.warn(f"Row {row_num}: student_id unusually long ({len(sid)} chars): {sid[:20]}...")
168:     return sid
169: 
170: 
171: def validate_name(raw: str, report: ValidationReport, row_num: int) -> Optional[str]:
172:     """Validate and clean student name."""
173:     if not raw or not raw.strip():
174:         report.error(f"Row {row_num}: Empty name")
175:         return None
176:     name = normalize_label(raw)
177:     if len(name) < 2:
178:         report.warn(f"Row {row_num}: Name very short: '{name}'")
179:     if any(c.isdigit() for c in name):
180:         report.warn(f"Row {row_num}: Name contains digits: '{name}'")
181:     return name
182: 
183: 
184: def validate_float(raw: str, default: float, field_name: str, row_num: int,
185:                    report: ValidationReport, min_val: float = 0.0, max_val: float = 1.0) -> float:
186:     """Validate and convert to float with bounds checking."""
187:     if not raw or not str(raw).strip():
188:         return default
189:     try:
190:         val = float(str(raw).strip())
191:         if val < min_val or val > max_val:
192:             report.warn(f"Row {row_num}: {field_name}={val} outside [{min_val}, {max_val}], clamping")
193:             val = max(min_val, min(max_val, val))
194:         return val
195:     except (ValueError, TypeError):
196:         report.warn(f"Row {row_num}: Invalid {field_name}='{raw}', using default {default}")
197:         return default
198: 
199: 
200: def validate_int(raw: str, default: int, field_name: str, row_num: int,
201:                  report: ValidationReport, min_val: int = 0, max_val: int = 100) -> int:
202:     """Validate and convert to int with bounds checking."""
203:     if not raw or not str(raw).strip():
204:         return default
205:     try:
206:         val = int(float(str(raw).strip()))
207:         if val < min_val or val > max_val:
208:             report.warn(f"Row {row_num}: {field_name}={val} outside [{min_val}, {max_val}], clamping")
209:             val = max(min_val, min(max_val, val))
210:         return val
211:     except (ValueError, TypeError):
212:         report.warn(f"Row {row_num}: Invalid {field_name}='{raw}', using default {default}")
213:         return default
214: 
215: 
216: def validate_difficulty(raw: str, row_num: int, report: ValidationReport) -> int:
217:     """Validate content difficulty (1-5)."""
218:     if not raw or not str(raw).strip():
219:         report.error(f"Row {row_num}: Empty difficulty")
220:         return 3  # default mid-range
221:     try:
222:         diff = int(float(str(raw).strip()))
223:         if diff < MIN_DIFFICULTY or diff > MAX_DIFFICULTY:
224:             report.warn(f"Row {row_num}: difficulty={diff} outside [{MIN_DIFFICULTY}, {MAX_DIFFICULTY}], clamping")
225:             diff = max(MIN_DIFFICULTY, min(MAX_DIFFICULTY, diff))
226:         return diff
227:     except (ValueError, TypeError):
228:         report.error(f"Row {row_num}: Invalid difficulty='{raw}'")
229:         return 3
230: 
231: 
232: def validate_content_type(raw: str, row_num: int, report: ValidationReport) -> str:
233:     """Validate content type."""
234:     if not raw or not raw.strip():
235:         report.error(f"Row {row_num}: Empty content_type")
236:         return "reading"  # default
237:     ct = raw.strip().lower()
238:     if ct not in VALID_CONTENT_TYPES:
239:         report.warn(f"Row {row_num}: Unknown content_type='{raw}', using 'reading'")
240:         return "reading"
241:     return ct
242: 
243: 
244: def validate_topic(raw: str, row_num: int, report: ValidationReport) -> str:
245:     """Validate and clean topic."""
246:     if not raw or not raw.strip():
247:         report.error(f"Row {row_num}: Empty topic")
248:         return "General"
249:     return normalize_label(raw)
