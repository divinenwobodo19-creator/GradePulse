251: 
252: def parse_grade_history(row: Dict, row_num: int, report: ValidationReport) -> Dict[str, List[float]]:
253:     """Extract grade history from row columns."""
254:     history = {}
255:     topic_cols = [k for k in row.keys() if k.lower().startswith("grade_history_")]
256:     for col in topic_cols:
257:         topic = col.replace("grade_history_", "").replace("grade_history", "").strip()
258:         if not topic:
259:             topic = "General"
260:         raw_val = row.get(col, "")
261:         if raw_val and str(raw_val).strip():
262:             try:
263:                 scores = [float(s.strip()) for s in str(raw_val).split(";") if s.strip()]
264:                 scores = [max(0.0, min(1.0, s)) for s in scores]  # clamp to [0,1]
265:                 if scores:
266:                     history[normalize_label(topic)] = scores
267:             except (ValueError, TypeError):
268:                 report.warn(f"Row {row_num}: Could not parse grade_history for topic '{topic}'")
269:     return history
