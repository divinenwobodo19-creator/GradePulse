398: def ingest_content(
399:     filepath: str,
400:     brain_contents: Dict[str, Content],
401:     dry_run: bool = False,
402: ) -> ValidationReport:
403:     """
404:     Ingest content catalog from CSV/Excel.
405: 
406:     Expected CSV columns:
407:         Required: content_id, title, topic, difficulty, content_type
408:     """
409:     report = ValidationReport()
410:     rows = read_data_file(filepath)
411:     report.stats["content_read"] = len(rows)
412: 
413:     if not rows:
414:         report.warn("No rows found in content file")
415:         return report
416: 
417:     # Validate columns
418:     actual_cols = set(rows[0].keys())
419:     missing = [c for c in CONTENT_REQUIRED if c not in actual_cols]
420:     if missing:
421:         report.error(f"Missing required columns: {missing}")
422:         return report
423: 
424:     for i, row in enumerate(rows, start=2):
425:         cid = row.get("content_id", "").strip()
426:         title = row.get("title", "").strip()
427:         topic = validate_topic(row.get("topic", ""), i, report)
428:         difficulty = validate_difficulty(row.get("difficulty", ""), i, report)
429:         content_type = validate_content_type(row.get("content_type", ""), i, report)
430: 
431:         if not cid:
432:             report.error(f"Row {i}: Empty content_id")
433:             report.stats["content_skipped"] += 1
434:             continue
435:         if not title:
436:             report.error(f"Row {i}: Empty title")
437:             report.stats["content_skipped"] += 1
438:             continue
439: 
440:         if not dry_run:
441:             if cid in brain_contents:
442:                 # Update existing content
443:                 c = brain_contents[cid]
444:                 c.title = title
445:                 c.topic = topic
446:                 c.difficulty = difficulty
447:                 c.content_type = content_type
448:             else:
449:                 brain_contents[cid] = Content(
450:                     content_id=cid,
451:                     title=title,
452:                     topic=topic,
453:                     difficulty=difficulty,
454:                     content_type=content_type,
455:                 )
456: 
457:         report.stats["content_valid"] += 1
458: 
459:     return report
