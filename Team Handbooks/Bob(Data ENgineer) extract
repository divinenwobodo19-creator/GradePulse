160: def validate_student_id(raw: str, report: ValidationReport, row_num: int) -> Optional[str]:
161:     """Validate and clean student ID."""
162:     if not raw or not raw.strip():
163:         report.error(f"Row {row_num}: Empty student_id")
164:         return None
165:     sid = raw.strip()
166:     if len(sid) > 50:
167:         report.warn(f"Row {row_num}: student_id unusually long ({len(sid)} chars): {sid[:20]}...")
