215: 
216: def validate_difficulty(raw: str, row_num: int, report: ValidationReport) -> int:
217:     """Validate content difficulty (1-5)."""
218:     if not raw or not str(raw).strip():
219:         report.error(f"Row {row_num}: Empty difficulty")
220:         return 3  # default mid-range
221:     try:
222:         diff = int(float(str(raw).strip()))
223:         if diff < MIN_DIFFICULTY or diff > MAX_DIFFICULTY:
224:             report.warn(f"Row {row_num}: difficulty={diff} outside [{MIN_DIFFICULTY}, {MAX_DIFFICULTY}], clamping")
225:             diff = max(MIN_DIFFICULTY, min(MAX_DIFFICULTY, diff))
226:         return diff
227:     except (ValueError, TypeError):
228:         report.error(f"Row {row_num}: Invalid difficulty='{raw}'")
229:         return 3
