171: def validate_name(raw: str, report: ValidationReport, row_num: int) -> Optional[str]:
172:     """Validate and clean student name."""
173:     if not raw or not raw.strip():
174:         report.error(f"Row {row_num}: Empty name")
175:         return None
176:     name = normalize_label(raw)
177:     if len(name) < 2:
178:         report.warn(f"Row {row_num}: Name very short: '{name}'")
179:     if any(c.isdigit() for c in name):
180:         report.warn(f"Row {row_num}: Name contains digits: '{name}'")
181:     return name
