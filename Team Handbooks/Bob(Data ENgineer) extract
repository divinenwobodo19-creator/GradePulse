64: class ValidationReport:
65:     """Collects errors and warnings during data validation."""
66: 
67:     def __init__(self):
68:         self.errors: List[str] = []
69:         self.warnings: List[str] = []
70:         self.stats = {
71:             "students_read": 0,
72:             "students_valid": 0,
73:             "students_skipped": 0,
74:             "content_read": 0,
75:             "content_valid": 0,
76:             "content_skipped": 0,
77:             "schools_created": 0,
78:             "classes_created": 0,
79:         }
80: 
81:     def error(self, msg: str):
82:         self.errors.append(msg)
83: 
84:     def warn(self, msg: str):
85:         self.warnings.append(msg)
86: 
87:     def summary(self) -> str:
88:         lines = ["=" * 60, "INGESTION REPORT", "=" * 60]
89:         lines.append(f"\nStudents: {self.stats['students_valid']} valid / {self.stats['students_read']} read / {self.stats['students_skipped']} skipped")
90:         lines.append(f"Content:  {self.stats['content_valid']} valid / {self.stats['content_read']} read / {self.stats['content_skipped']} skipped")
91:         lines.append(f"Schools created: {self.stats['schools_created']}")
92:         lines.append(f"Classes created: {self.stats['classes_created']}")
93:         if self.warnings:
94:             lines.append(f"\nWarnings ({len(self.warnings)}):")
95:             for w in self.warnings[:20]:
96:                 lines.append(f"  ⚠ {w}")
97:             if len(self.warnings) > 20:
98:                 lines.append(f"  ... and {len(self.warnings) - 20} more")
99:         if self.errors:
100:             lines.append(f"\nErrors ({len(self.errors)}):")
101:             for e in self.errors[:20]:
102:                 lines.append(f"  ✗ {e}")
103:             if len(self.errors) > 20:
104:                 lines.append(f"  ... and {len(self.errors) - 20} more")
105:         lines.append("=" * 60)
106:         return "\n".join(lines)
