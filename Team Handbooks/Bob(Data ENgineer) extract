147: def read_data_file(filepath: str) -> List[Dict]:
148:     """Read CSV or Excel file based on extension."""
149:     ext = Path(filepath).suffix.lower()
150:     if ext == ".csv":
151:         return read_csv(filepath)
152:     elif ext in (".xlsx", ".xls"):
153:         return read_excel(filepath)
154:     else:
155:         raise ValueError(f"Unsupported file format: {ext}. Use .csv or .xlsx")
