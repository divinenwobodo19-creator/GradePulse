231: 
232: def validate_content_type(raw: str, row_num: int, report: ValidationReport) -> str:
233:     """Validate content type."""
234:     if not raw or not raw.strip():
235:         report.error(f"Row {row_num}: Empty content_type")
236:         return "reading"  # default
237:     ct = raw.strip().lower()
238:     if ct not in VALID_CONTENT_TYPES:
239:         report.warn(f"Row {row_num}: Unknown content_type='{raw}', using 'reading'")
240:         return "reading"
241:     return ct
