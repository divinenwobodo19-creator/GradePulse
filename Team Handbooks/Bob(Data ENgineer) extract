244: def validate_topic(raw: str, row_num: int, report: ValidationReport) -> str:
245:     """Validate and clean topic."""
246:     if not raw or not raw.strip():
247:         report.error(f"Row {row_num}: Empty topic")
248:         return "General"
249:     return normalize_label(raw)
