274: def ingest_students(
275:     filepath: str,
276:     registry: dict,
277:     brain_students: Dict[str, Student],
278:     school_id: Optional[str] = None,
279:     school_name: Optional[str] = None,
280:     dry_run: bool = False,
281: ) -> ValidationReport:
282:     """
283:     Ingest student roster from CSV/Excel into the multi-tenant schema.
284: 
285:     Expected CSV columns:
286:         Required: student_id, name
287:         Optional: class_label, grade_level, arm, school_name,
288:                   performance_score, session_count, current_topic,
289:                   education_level, age_band, credits_studied, imd_band, region_code,
290:                   grade_history_math, grade_history_science, etc.
291:     """
292:     report = ValidationReport()
293:     rows = read_data_file(filepath)
294:     report.stats["students_read"] = len(rows)
295: 
296:     if not rows:
297:         report.warn("No rows found in student file")
298:         return report
299: 
300:     # Validate columns
301:     actual_cols = set(rows[0].keys())
302:     missing = [c for c in STUDENT_REQUIRED if c not in actual_cols]
303:     if missing:
304:         report.error(f"Missing required columns: {missing}")
305:         return report
306: 
307:     for i, row in enumerate(rows, start=2):  # row 1 = header
308:         sid = validate_student_id(row.get("student_id", ""), report, i)
309:         name = validate_name(row.get("name", ""), report, i)
310:         if not sid or not name:
311:             report.stats["students_skipped"] += 1
312:             continue
313: 
314:         # Determine school
315:         s_id = school_id
316:         s_name = school_name or row.get("school_name", "").strip()
317:         if not s_id and s_name:
318:             school = ensure_school(registry, s_name)
319:             s_id = school["school_id"]
320:             if school not in [s for s in registry["schools"] if s["school_id"] == s_id]:
321:                 report.stats["schools_created"] += 1
322:         elif not s_id:
323:             # Use first school in registry or create default
324:             if registry["schools"]:
325:                 s_id = registry["schools"][0]["school_id"]
326:             else:
327:                 school = ensure_school(registry, "MY SCHOOL")
328:                 s_id = school["school_id"]
329:                 report.stats["schools_created"] += 1
330: 
331:         # Determine class
332:         class_label = row.get("class_label", "").strip()
333:         grade_level = row.get("grade_level", "").strip().upper()
334:         arm = row.get("arm", "").strip().upper()
335:         c_id = ""
336: 
337:         if class_label:
338:             # Try to find or create class
339:             cls = add_class(registry, s_id, class_label)
340:             if cls:
341:                 c_id = cls["class_id"]
342:                 report.stats["classes_created"] += 1
343:             else:
344:                 # Class might already exist, find it
345:                 from linucb_brain.registry import get_classes
346:                 for c in get_classes(registry, s_id):
347:                     if c["label"] == normalize_label(class_label):
348:                         c_id = c["class_id"]
349:                         break
350: 
351:         # Validate numeric fields
352:         perf = validate_float(row.get("performance_score", ""), 0.5, "performance_score", i, report)
353:         sessions = validate_int(row.get("session_count", ""), 0, "session_count", i, report, min_val=0, max_val=10000)
354:         edu = validate_float(row.get("education_level", ""), DEFAULT_EDUCATION_LEVEL, "education_level", i, report, min_val=0, max_val=10)
355:         age = validate_float(row.get("age_band", ""), DEFAULT_AGE_BAND, "age_band", i, report, min_val=0, max_val=10)
356:         credits = validate_float(row.get("credits_studied", ""), DEFAULT_CREDITS, "credits_studied", i, report, min_val=0, max_val=100)
357:         imd = validate_float(row.get("imd_band", ""), DEFAULT_IMD_BAND, "imd_band", i, report, min_val=0, max_val=1)
358:         region = validate_float(row.get("region_code", ""), DEFAULT_REGION_CODE, "region_code", i, report, min_val=0, max_val=100)
359:         topic = normalize_label(row.get("current_topic", ""))
360: 
361:         # Parse grade history
362:         grade_history = parse_grade_history(row, i, report)
363: 
364:         # Build student kwargs
365:         kwargs = {
366:             "performance_score": perf,
367:             "session_count": sessions,
368:             "current_topic": topic,
369:             "education_level": edu,
370:             "age_band": age,
371:             "credits_studied": credits,
372:             "imd_band": imd,
373:             "region_code": region,
374:             "grade_history": grade_history,
375:             "school_id": s_id,
376:             "class_id": c_id,
377:         }
378: 
379:         if not dry_run:
380:             if sid in brain_students:
381:                 # Update existing student
382:                 s = brain_students[sid]
383:                 for k, v in kwargs.items():
384:                     if k in ("school_id", "class_id"):
385:                         setattr(s, k, v)
386:                     elif k == "grade_history":
387:                         s.grade_history.update(v)
388:                     elif k != "session_count":  # don't overwrite session count on update
389:                         setattr(s, k, v)
390:             else:
391:                 brain_students[sid] = Student(student_id=sid, name=name, **kwargs)
392: 
393:         report.stats["students_valid"] += 1
394: 
395:     return report
396: 
