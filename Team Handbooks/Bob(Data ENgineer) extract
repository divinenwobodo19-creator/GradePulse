111: def read_csv(filepath: str) -> List[Dict]:
112:     """Read CSV file, handling various encodings and edge cases."""
113:     rows = []
114:     encodings = ["utf-8", "latin-1", "cp1252", "iso-8859-1"]
115:     for enc in encodings:
116:         try:
117:             with open(filepath, "r", encoding=enc, newline="") as f:
118:                 # Sniff dialect
119:                 sample = f.read(4096)
120:                 f.seek(0)
121:                 try:
122:                     dialect = csv.Sniffer().sniff(sample, delimiters=",;\t|")
123:                 except csv.Error:
124:                     dialect = csv.excel
125:                 reader = csv.DictReader(f, dialect=dialect)
126:                 for row in reader:
127:                     # Strip whitespace from keys and values
128:                     cleaned = {k.strip(): v.strip() if isinstance(v, str) else v for k, v in row.items() if k}
129:                     rows.append(cleaned)
130:             return rows
131:         except (UnicodeDecodeError, UnicodeError):
132:             continue
133:     raise ValueError(f"Could not read {filepath} with any supported encoding")
134: 
135: 
136: def read_excel(filepath: str) -> List[Dict]:
137:     """Read Excel file using pandas."""
138:     try:
139:         import pandas as pd
140:     except ImportError:
141:         raise ImportError("pandas is required for Excel files. Install with: pip install pandas openpyxl")
142:     df = pd.read_excel(filepath, dtype=str)
143:     df = df.fillna("")
144:     return df.to_dict("records")
