# GradePulse Production Configuration
# ===================================
# Copy this file to .env and update values for your environment

# ── API Server ────────────────────────────────────────────────────────────────
# uvicorn workers (1 = single process, >1 = multi-worker with sync)
WEB_CONCURRENCY=1

# Host and port
HOST=0.0.0.0
PORT=8000

# Runtime environment. "production" makes the server fail-fast unless JWT_SECRET
# is a strong, non-placeholder value (see JWT section below).
GRADEPULPE_ENV=development

# CORS origins (comma-separated for multiple) — the frontend proxies same-origin,
# so direct-access callers (e.g. Swagger) are the only ones affected here.
# For Vercel deployment: https://gradepulse.vercel.app
FRONTEND_URL=http://localhost:3000

# ── Brain State Storage ──────────────────────────────────────────────────────
# Paths to brain state and config files (relative or absolute)
BRAIN_STATE_PATH=brain_state.json
CONFIG_PATH=class_config.json

# Auto-save interval in seconds (0 to disable)
AUTO_SAVE_INTERVAL=30.0

# ── Backup Configuration ─────────────────────────────────────────────────────
# Enable automated backups (true/false)
BACKUP_ENABLED=true

# Backup directory (relative or absolute)
BACKUP_DIR=backups

# Maximum number of backups to keep (0 = unlimited)
BACKUP_MAX_COUNT=24

# Backup interval in seconds (default: 6 hours)
BACKUP_INTERVAL=21600

# ── User Database ────────────────────────────────────────────────────────────
# SQLite database path for user accounts
USER_DB_PATH=gradepulse_users.db

# ── JWT Authentication ───────────────────────────────────────────────────────
# IMPORTANT: In production generate a strong random secret, e.g.
#   python3 -c "import secrets; print(secrets.token_urlsafe(64))"
# and set GRADEPULPE_ENV=production. The placeholders below are REJECTED at
# boot in production (the server refuses to start).
JWT_SECRET=change-this-to-a-strong-random-secret-in-production

# Token expiry in minutes (default: 7 days)
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# ── Rate Limiting (optional overrides) ──────────────────────────────────────
# Per-60s caps for the auth endpoints. Production defaults when unset:
#   RATE_LIMIT_LOGIN_EMAIL=30   (30/min per email+IP)
#   RATE_LIMIT_LOGIN_HOST=120   (120/min per IP)
#   RATE_LIMIT_SIGNUP_HOST=30   (30/min per IP)
# A pilot/demo instance behind one classroom IP should RAISE these:
RATE_LIMIT_LOGIN_EMAIL=30
RATE_LIMIT_LOGIN_HOST=120
RATE_LIMIT_SIGNUP_HOST=30

# ── Logging ──────────────────────────────────────────────────────────────────
# Log level (debug, info, warning, error, critical — lowercase, passthrough to uvicorn)
LOG_LEVEL=info

# ── Data Directory ───────────────────────────────────────────────────────────
# Base directory for all data files (absolute path recommended for production)
# DATA_DIR=/var/lib/gradepulse

# ── Docker ───────────────────────────────────────────────────────────────────
# Port for the frontend container (mapped to host)
# WEB_PORT=3000
#
# Full Docker quick start:
#   cp .env.example .env
#   # Edit .env — set JWT_SECRET at minimum
#   docker compose up -d --build
#   # API: http://localhost:8000  |  Frontend: http://localhost:3000
#
# Data persists in the `gradepulse-data` Docker volume.
# Backups are stored inside the volume at /data/backups/.
